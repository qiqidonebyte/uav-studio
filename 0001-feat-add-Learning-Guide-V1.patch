+        <div v-if="worksheet" class="worksheet-list">
+          <article v-for="item in worksheetRows" :key="item.label"><i>{{ item.index }}</i><div><small>{{ item.label }}</small><p>{{ item.value || '尚未填写' }}</p></div></article>
