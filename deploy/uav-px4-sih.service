[Unit]
Description=UAV Studio PX4 SIH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/PX4-Autopilot
Environment=GIT_SUBMODULES_ARE_EVIL=1
ExecStart=/usr/bin/make px4_sitl_default sihsim_quadx
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
